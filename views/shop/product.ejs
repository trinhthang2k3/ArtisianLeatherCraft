<%- include ../partials/header %>  <%- include ../partials/categories-navbar %>
<div class="container">
  <!-- Flash messages -->
  <div class="row mt-3 mb-3">
    <div class="col-md-12 m-auto">
      <% if (successMsg) { %>
      <div id="success" class="alert alert-success">
        <%= successMsg %>
      </div>
      <% } else { %>
      <div id="success" class="alert alert-success d-none"></div>
      <% } %>
    </div>
    <div class="col-md-12 m-auto">
      <% if (errorMsg) { %>
      <div id="error" class="alert alert-danger">
        <%= errorMsg %>
      </div>
      <% } else { %>
      <div id="error" class="alert alert-danger d-none"></div>
      <% } %>
    </div>
  </div>
  <!-- Product info -->
  <div class="row mt-4 mb-4">
    <div class="col-md-5 mt-2 mr-2 ml-auto">
      <img
        src="<%=product.imagePath%>"
        class="img-fluid img-aspectRatio"
        alt="product image"
      />
    </div>
    <div class="col-md-5 mt-2 mb-2 ml-2 mr-auto text-dark">
      <h2><%=product.title%></h2>
      <hr />
      <p class="price"><%=product.price.toLocaleString() %> Đồng</p>
      <p class="lead"> Miêu tả sản phẩm: 
        <p><%=product.description%></p>
      </p>
      <p><strong>Danh mục:</strong> <%=product.category.title%></p>
      <p><strong>Mã sản phẩm:</strong> <%=product.productCode%></p>
      <p><strong>Số sao đánh giá:</strong> <%=product.rating%> </p>
      <p><strong>Ngày sản xuất:</strong> <%= moment(product.createdAt).format( 'MMMM Do YYYY')%></p>
      <% if(product.available) {%>
      <p class="is-available text-center">Còn hàng</p>
      <a href="/add-to-cart/<%=product._id%>" class="btn btn-block btn-secondary mt-3 mb-3 button-style">
        Thêm vào giỏ hàng
      </a>
      <% } else { %>
      <p class="is-not-available text-center">Đã hết</p>
      <%} %>
    </div>
  </div>
</div>
<%- include ../partials/footer %>
