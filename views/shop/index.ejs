<%- include ../partials/header %>
<%- include ../partials/categories-navbar %>

<div class="container-fluid">
  <!-- Flash messages -->
  <% if(successMsg || errorMsg) {%>
  <div class="row mt-3 mb-3">
    <div class="col-md-12 m-auto">
      <% if (successMsg) { %>
      <div id="success" class="alert alert-success">
        <%= successMsg %>
      </div>
      <% } else { %>
      <div id="success" class="alert alert-success d-none"></div>
      <% } %>
    </div>
    <div class="col-md-12 m-auto">
      <% if (errorMsg) { %>
      <div id="error" class="alert alert-danger">
        <%= errorMsg %>
      </div>
      <% } else { %>
      <div id="error" class="alert alert-danger d-none"></div>
      <% } %>
    </div>
  </div>
  <% } %>
  <!-- Breadcrumbs -->
  <div class="row mt-2">
    <div class="col-md-12 m-auto">
      <%if (breadcrumbs) { %>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <% breadcrumbs.forEach(crumb => { if(!crumb.name.startsWith("?")){%>
          <li class="breadcrumb-item" aria-current="page">
            <a href="<%=crumb.url%>"><%= crumb.name %></a>
          </li>
          <%}})%>
        </ol>
      </nav>
      <%} %>
    </div>
  </div>
  <!-- Page banner image -->

  <% if(pageName == 'All Products') { %>
  <div class="text-center hero-container">
    <img
      class="d-block w-100 hero-image"
      src="/images/banner-all-products.jpg"
    />
    <div class="hero-text">
      <h1><%=pageName%></h1>
    </div>
  </div>
  <%} else {%> <%categories.forEach( category => {%> <%if(pageName ==
  category.title){%>
  <div class="text-center hero-container">
    <img
      class="d-block w-100 hero-image"
    />
    <div class="hero-text">
      <h1><%=pageName%></h1>
    </div>
  </div>
  <%}%> <%})%> <%}%>

  <hr class="gradient-style" />
  <!-- Contents -->
  <form id="filter-form" action="/products" method="GET">
    <div class="row pl-4 pr-4">
      <div class="col-lg-3 col-md-4 col-sm-12 col-xs-12 filter-area">
        <div class="bolocsanpham">
          <h3>Bộ lọc sản phẩm
             <button type="submit" name="sort" value="newest">
            <span class="icon">&#x2193;</span>
             Mới nhất
          </button>
        </h3>  
        </div>
        <hr>
        <div class="filter-section">
          <h5>Danh mục sản phẩm</h5>
          <ul>
            <% categories.forEach(category => { %>
              <li <% if (pageName === category.title) { %>
                class="active"
              <% } %>>
                <label>
                  <input
                    type="checkbox" hidden
                    name="category"
                    <% if (pageName === category.title) { %>
                      checked
                    <% } %> 
                    >
                   <a href="/products/<%= category.slug %>"><%= category.title %></a>
                  
                </label>
              </li>
            <% }) %>
          </ul>
        </div>  
      <div class="filter-section">
        <h5>Mức giá</h5>
        <ul>
          <li>
            <label>
              <input type="checkbox" name="price" value="1" >
              Dưới 1 triệu đồng
            </label>
          </li>
          <li>
            <label>
              <input type="checkbox" name="price" value="2" >
              1 đến 2 triệu đồng
            </label>
          </li>
          <li>
            <label>
              <input type="checkbox" name="price" value="3" >
              2 đến 3 triệu đồng
            </label>
          </li>
        </ul>
      </div>
      <div class="filter-section">
        <h5>Mức đánh giá</h5>
        <ul>
          <li>
            <label>
              <input type="checkbox" name="rating" value="3" >
              <span class="star">&#9733;&#9733;&#9733;</span>
            </label>
          </li>
          <li>
            <label>
              <input type="checkbox" name="rating" value="4" >
              <span class="star">&#9733;&#9733;&#9733;&#9733;</span>
            </label>
          </li>
          <li>
            <label>
              <input type="checkbox" name="rating" value="5" >
              <span class="star">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </label>
          </li>
        </ul>
      </div>
      <div class="filter-section">
        <h5>Sắp xếp sản phẩm</h5>
        <div>
          <label for="sort-by-low-to-high">
            <input type="checkbox" id="sort-by-low-to-high" name="sort" value="price-low-to-high" >
            Giá từ thấp đến cao
          </label>
        </div>
        <div>
          <label for="sort-by-high-to-low">
            <input type="checkbox" id="sort-by-high-to-low" name="sort" value="price-high-to-low" >
            Giá từ cao đến thấp
          </label>
        </div>
      </div>
      <button class="btn btn-primary apply-filters" type="button" onclick="clearAllChoices()">Xóa tất cả</button>
      <button class="btn btn-primary apply-filters" type="submit">Tìm theo bộ lọc</button>
      </div>
  </form>

    <!-- Product List -->
    <div class="col-lg-9 col-md-8 col-sm-12 col-xs-12">
      <div class="row">
        <% products.forEach((product) => { %>
        <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 product-index-box">
          <div class="single-product d-flex flex-column h-100">
            <a
              class="title-link"
              href="/products/<%=product.category.slug%>/<%=product._id%>"
            >
              <img src="<%= product.imagePath %>" alt="Bag" class="img-fluid" />
            </a>
            <div class="product-info">
              <a
                class="title-link"
                href="/products/<%=product.category.slug%>/<%=product._id%>"
              >
                <h6 class="mt-2 mb-2"><%= product.title %></h6>
              </a>
              <div class="price"><%= product.price.toLocaleString() %> Đồng</div>
            </div>
            <% if(product.available) { %>
            <a
              href="/add-to-cart/<%=product._id%>"
              class="btn btn-block btn-secondary button-style mt-auto mb-2"
            >
              Thêm vào giỏ hàng
            </a>
            <% } else { %>
            <a
              href="#"
              class="btn btn-block btn-danger button-style-danger mt-2 mb-2"
            >
              Đã hết
            </a>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <%- include ../partials/pagination %>
</div>
<%- include ../partials/footer %>
<script>
  function clearAllChoices() {
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    
    checkboxes.forEach(checkbox => {
      checkbox.checked = false;
    });
  }
</script>
