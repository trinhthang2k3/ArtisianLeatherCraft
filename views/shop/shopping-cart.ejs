<%- include ../partials/header %>
<%- include ../partials/categories-navbar %>
<div class="container cart">
  <% if (cart != null && !cart.paid) { %>
    <div class="row">
      <div class="col-md-11 col-sm-12 m-auto table-responsive">
        <table class="table text-center">
          <thead>
            <tr>
              <th>Sản phẩm</th>
              <th>&nbsp;</th>
              <th>&nbsp;</th>
              <th>Số lượng</th>
              <th>&nbsp;</th>
              <th>Đơn giá</th>
              <th>Xóa sản phẩm</th>
              <th>&nbsp;</th>
            </tr>
          </thead>
          <tbody>
<% products.forEach(product => { %>
  <% if (product != null) { %>
    <tr class="my-auto">
      <td>
        <a href="/products/<%= product.category.slug %>/<%= product._id %>">
          <img src="<%= product.imagePath %>" class="img-small img-fluid" alt="image thumbnail" />
        </a>
      </td>
      <td>
        <div class="float-left mb-3">
          <a class="title-link" href="/products/<%= product.category.slug %>/<%= product._id %>">
            <h6 class="text-left"><%= product.title %></h6>
            <p class="text-left">Mã sản phẩm: <%= product.productCode %></p>
          </a>
        </div>
      </td>
      <td class="text-center">
        <a href="/add-to-cart/<%= product._id %>" class="btn btn-danger btn-sm button-style-danger"><i class="fa fa-plus" aria-hidden="true"></i></a>
      </td>
      <td class="text-center">
        <p class="qty-display pt-1"><%= product.qty %></p>
      </td>
      <td class="text-center">
        <a href="/reduce/<%= product._id %>" onclick="return confirm('Bạn có muốn bỏ sản phẩm này không?');" class="btn btn-danger btn-sm button-style-danger">
          <i class="fa fa-minus" aria-hidden="true"></i>
        </a>
      </td>
      <td><%= product.price.toLocaleString() %> Đồng</td>
      <td class="text-center">
        <a href="/removeAll/<%= product._id %>">
          <button type="submit" class="btn btn-danger btn-sm button-style-danger" onclick="return confirm('Bạn có muốn bỏ toàn bộ sản phẩm này không?');">
            Xóa sản phẩm
          </button>
        </a>
      </td>
    </tr>
  <% } %>
<% }) %>

            
            
          </tbody>
        </table>
      </div>
    </div>
    <hr>
    <div class="row mt-4 mr-auto">
      <div class="col-md-11 col-sm-12 m-auto">
        <strong>Tổng giá tiền: <%= cart.totalCost.toLocaleString() %> Đồng</strong>
      </div>
    </div>
    <div class="row mt-2 mr-auto">
      <div class="col-md-11 col-sm-12 m-auto">
        <a href="/checkout" class="btn btn-dark button-style">Thanh toán</a>
      </div>
    </div>
  <% } else { %>
    <div class="row text-center">
      <div class="col-md-9 col-sm-9 m-auto">
        <h2>Hiện không có sản phẩm nào. Vui lòng xem qua trang sản phẩm</h2>
      </div>
    </div>
  <% } %>
</div>

<%- include ../partials/footer %>
