<%- include ../partials/header %> <%- include ../partials/categories-navbar %>

<div class="container">
  <div class="row">
    <div class="col-lg-8 col-md-12 m-auto">
      <h1 class="mt-4 mb-4 text-center">Contact Us</h1>
      <!-- Flash message -->
      <% if (successMsg != null && successMsg) { %>
        <div id="success" class="alert alert-success">
          <%= successMsg %>
        </div>
        <% } %>
    </div>
    <div class="col-lg-8 col-md-12 text-justify m-auto">
      <!-- Introduction -->
    <div class="mt-4 mb-4">
      <p>Chúng tôi luôn sẵn sàng nhận được sự liên hệ của bạn mọi lúc! Đừng ngần ngại kết nối với chúng tôi qua thông tin ở dưới<br />
        Bạn cũng có thể gặp chúng tôi ở cửa hàng bất cứ lúc nào trong giờ làm việc <i>Thứ 2 - Chủ nhật: 9 giờ đến 11 giờ</i> <br />
        Chúng tôi sẽ luôn trả lời thông tin của bạn kể cả cuối tuần nên đừng ngần ngại liên hệ với chúng tôi
      </p>
    </div>
      <!-- Email contacts -->
      <div class="mt-4 mb-4">
        <p>
          <h6><i>Liên lạc với chúng tôi qua email</i></h6>
        </p>
        <p>
          Email cho mục đích chung:
          <a href="mailto:artisianleathercraft@email.com">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <u>artisianleathercraft@email.com</u>
          </a>
        </p>
        <p>
          Email cho vấn đề về các đơn đặt hàng:
          <a href="mailto:ALCorders@email.com">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <u>ALCorders@email.com</u>
          </a>
        </p>
        <p>
          Email cho các vấn đề kỹ thuật hỗ trợ:
          <a href="mailto:ALCsupport@email.com">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <u>ALCsupport@email.com</u>
          </a>
        </p>
      </div>
      <!-- Phone contacts -->
      <div class="mt-4 mb-4">
        <p>
          <h6><i>Số điện thoại liên lạc của chúng tôi</i></h6>
        </p>
        <p>
          Gọi cho số điện thoại chính:
          <a href="tel:555-555-5555">
            <i class="fa fa-phone" aria-hidden="true"></i>
            555-555-5555
           </a>
        </p>
        <p>
          Gọi cho số điện thoại dự phòng:
          <a href="tel:555-555-6666">
            <i class="fa fa-phone" aria-hidden="true"></i>
            555-555-6666
           </a>
        </p>
        <p>
          Liên lạc với chúng tôi qua Whatsapp
          <a href="tel:123-456-7890">
            <i class="fa fa-phone" aria-hidden="true"></i>
            123-456-7890
           </a>
        </p>
      </div>
    </div>

    <!-- Contact us form -->
    <div class="col-lg-8 col-md-12 m-auto">
      <div class="mt-5 mb-4">
        <h2>Bảng thông tin liên hệ</h2>
        <!-- Error flash message -->
        <% if(errorMsg!=null && errorMsg.length>0) {%>
          <div id="flash-msg" class="alert alert-danger">
            <% errorMsg.forEach((message) => { %>
            <p>
              <%=message %>
            </p>
            <%}) %>
          </div>
          <%}%>
        <form action="/pages/contact-us" method="POST">
          <div class="form-group">
            <label for="name">Tên</label>
            <input type="name" class="form-control" name="name" id="name" required />
          </div>
          <div class="form-group">
            <label for="email">Địa chỉ mail của bạn</label>
            <input type="email" class="form-control" name="email" id="email" required />
          </div>
          <div class="form-group">
            <label for="message">Thông tin liên hệ</label>
            <textarea class="form-control" name="message" id="message" rows="5" placeholder="Hãy viết suy nghĩ của bạn.." required></textarea>
          </div>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-primary button-style">
            Xác nhận
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include ../partials/footer %>
